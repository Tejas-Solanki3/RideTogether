rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null;
      // Before a real campus launch, also restrict the verified email domain
      // or use a server-issued campus membership claim (see setup guide).
    }
    function ridePath(id) { return /databases/$(database)/documents/rides/$(id); }
    function matchPath(id) { return /databases/$(database)/documents/matches/$(id); }
    function place(id) {
      return id in ['north_gate', 'riverside_metro', 'central_library',
        'maple_hostel', 'innovation_hub', 'sports_complex', 'lakeside_cafe'];
    }
    function validRide(r, id) {
      return r.keys().hasAll(['id','ownerId','ownerName','ownerAvatar','originId',
        'destinationId','kind','departureAt','dateKey','createdAt','updatedAt',
        'totalSeats','availableSeats','contribution','campusId','vehicle','note',
        'active','matchedId','lastMatchId'])
        && r.keys().hasOnly(['id','ownerId','ownerName','ownerAvatar','originId',
        'destinationId','kind','departureAt','dateKey','createdAt','updatedAt',
        'totalSeats','availableSeats','contribution','campusId','vehicle','note',
        'active','matchedId','lastMatchId'])
        && r.id == id && id.size() <= 80 && r.ownerId == request.auth.uid
        && r.ownerName is string && r.ownerName.size() >= 2 && r.ownerName.size() <= 80
        && r.ownerAvatar in ['', 'aarav', 'ananya', 'rohan']
        && r.campusId == 'greenfield' && place(r.originId) && place(r.destinationId)
        && r.originId != r.destinationId && r.kind in ['offer','request']
        && r.departureAt is timestamp && r.departureAt > request.time
        && r.departureAt < request.time + duration.value(366, 'd')
        && r.dateKey is string && r.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && r.createdAt == request.time && r.updatedAt == request.time
        && r.totalSeats is int && r.totalSeats >= 1 && r.totalSeats <= 6
        && r.availableSeats is int && r.availableSeats == r.totalSeats
        && r.contribution is int && r.contribution >= 0 && r.contribution <= 500
        && r.vehicle is string && r.vehicle.size() <= 60
        && (r.kind == 'request' ? r.vehicle == '' : r.vehicle.size() >= 2)
        && r.note is string && r.note.size() <= 300
        && r.active == true && r.matchedId == '' && r.lastMatchId == '';
    }
    function offerSeatMutation(id) {
      let before = resource.data;
      let after = request.resource.data;
      let mp = matchPath(after.lastMatchId);
      let m = getAfter(mp).data;
      return before.kind == 'offer'
        && after.diff(before).affectedKeys().hasOnly(['availableSeats','lastMatchId','updatedAt'])
        && after.updatedAt == request.time
        && after.availableSeats is int && after.availableSeats >= 0 && after.availableSeats <= before.totalSeats
        && m.offerId == id && request.auth.uid in m.participants
        && ((!exists(mp) && m.status == 'confirmed'
              && after.availableSeats == before.availableSeats - m.seats)
          || (exists(mp) && get(mp).data.status == 'confirmed' && m.status == 'cancelled'
              && after.availableSeats == before.availableSeats + m.seats));
    }
    function requestSeatMutation(id) {
      let before = resource.data;
      let after = request.resource.data;
      let mid = before.active ? after.matchedId : before.matchedId;
      let mp = matchPath(mid);
      let m = getAfter(mp).data;
      return before.kind == 'request'
        && after.diff(before).affectedKeys().hasOnly(['availableSeats','active','matchedId','updatedAt'])
        && after.updatedAt == request.time && m.requestId == id && m.riderId == before.ownerId
        && request.auth.uid in m.participants
        && ((before.active == true && !exists(mp) && m.status == 'confirmed'
            && after.active == false && after.availableSeats == 0 && after.matchedId == mid)
          || (before.active == false && exists(mp) && get(mp).data.status == 'confirmed'
            && m.status == 'cancelled' && after.active == true
            && after.availableSeats == before.totalSeats && after.matchedId == ''));
    }
    function validRequestConnection(m, o) {
      let r = get(ridePath(m.requestId)).data;
      let after = getAfter(ridePath(m.requestId)).data;
      return request.auth.uid in m.participants && r.kind == 'request' && r.active == true
        && r.ownerId == m.riderId && r.ownerName == m.riderName && r.ownerAvatar == m.riderAvatar
        && r.campusId == o.campusId && r.originId == o.originId && r.destinationId == o.destinationId
        && r.dateKey == o.dateKey
        && o.departureAt >= r.departureAt - duration.value(60, 'm')
        && o.departureAt <= r.departureAt + duration.value(60, 'm')
        && m.seats == r.totalSeats
        && after.active == false && after.availableSeats == 0 && after.matchedId == m.id;
    }
    function validMatch(m, id) {
      let o = get(ridePath(m.offerId)).data;
      let after = getAfter(ridePath(m.offerId)).data;
      return m.keys().hasAll(['id','offerId','requestId','driverId','riderId','driverName','riderName',
        'driverAvatar','riderAvatar','originId','destinationId','departureAt','createdAt',
        'updatedAt','seats','contribution','vehicle','campusId','status','participants'])
        && m.keys().hasOnly(['id','offerId','requestId','driverId','riderId','driverName','riderName',
        'driverAvatar','riderAvatar','originId','destinationId','departureAt','createdAt',
        'updatedAt','seats','contribution','vehicle','campusId','status','participants'])
        && m.id == id && id == m.offerId + '_' + m.riderId
        && o.kind == 'offer' && o.active == true && o.departureAt > request.time
        && m.driverId == o.ownerId && m.riderId != m.driverId
        && m.driverName == o.ownerName && m.driverAvatar == o.ownerAvatar
        && m.riderName is string && m.riderName.size() >= 2 && m.riderName.size() <= 80
        && m.riderAvatar in ['', 'aarav', 'ananya', 'rohan']
        && m.participants == [m.driverId, m.riderId]
        && m.originId == o.originId && m.destinationId == o.destinationId
        && m.departureAt == o.departureAt && m.campusId == o.campusId
        && m.contribution == o.contribution && m.vehicle == o.vehicle
        && m.createdAt == request.time && m.updatedAt == request.time
        && m.seats is int && m.seats >= 1 && m.seats <= o.availableSeats
        && m.status == 'confirmed' && after.availableSeats == o.availableSeats - m.seats
        && after.lastMatchId == id
        && (m.requestId == '' ? (request.auth.uid == m.riderId && m.seats == 1)
          : validRequestConnection(m, o));
    }
    function validCancellation(m) {
      let before = resource.data;
      let o = get(ridePath(before.offerId)).data;
      let after = getAfter(ridePath(before.offerId)).data;
      return request.auth.uid in before.participants && before.status == 'confirmed'
        && before.departureAt > request.time && m.status == 'cancelled'
        && m.diff(before).affectedKeys().hasOnly(['status','updatedAt'])
        && m.updatedAt == request.time
        && after.availableSeats == o.availableSeats + before.seats && after.lastMatchId == before.id
        && (before.requestId == '' ||
          (getAfter(ridePath(before.requestId)).data.active == true
            && getAfter(ridePath(before.requestId)).data.availableSeats == get(ridePath(before.requestId)).data.totalSeats
            && getAfter(ridePath(before.requestId)).data.matchedId == ''));
    }
    match /rides/{id} {
      allow read: if member();
      allow create: if member() && validRide(request.resource.data, id);
      allow update: if member() && (offerSeatMutation(id) || requestSeatMutation(id));
      allow delete: if false;
    }
    match /matches/{id} {
      // Transactions must be able to check an as-yet non-existent deterministic match ID.
      allow get: if member() && (!exists(matchPath(id)) || request.auth.uid in resource.data.participants);
      allow list: if member() && request.auth.uid in resource.data.participants;
      allow create: if member() && validMatch(request.resource.data, id);
      allow update: if member() && validCancellation(request.resource.data);
      allow delete: if false;
      match /messages/{messageId} {
        function conversation() { return get(matchPath(id)).data; }
        allow read: if member() && request.auth.uid in conversation().participants;
        allow create: if member() && request.auth.uid in conversation().participants
          && conversation().status == 'confirmed'
          && request.resource.data.keys().hasAll(['id','senderId','text','createdAt'])
          && request.resource.data.keys().hasOnly(['id','senderId','text','createdAt'])
          && request.resource.data.id == messageId && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000 && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
